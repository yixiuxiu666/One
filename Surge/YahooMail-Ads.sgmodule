#!name=Yahoo Mail 去广告（Taboola）
#!desc=过滤 Yahoo Mail iOS 的 Taboola 赞助广告；需开启 Rewrite 和 MITM 并信任证书。基于 26.39.0 抓包制作，广告空位能否消失需实机验证。
# Version: 1.0.0 / 2026-11-09
# Requires Surge iOS 5.14+ / macOS 5.9+ for jq body rewrite.
# Original rules based on the user's captured Yahoo Mail response.
# Only the yahoo-ios-mail recommendations.get endpoint is modified.
# Preserve response metadata, placement metadata, and non-sponsored items.
# No external scripts or resources. Does not target mailbox APIs.

[Body Rewrite]
http-response-jq ^https://api\.taboola\.com/2\.0/json/yahoo-ios-mail/recommendations\.get(?:\?|$) 'if type == "object" then (if (.placements | type) == "array" then .placements |= map(if type == "object" then (if (.list | type) == "array" then .list |= map(select(if type == "object" then ((.origin // "" | tostring | ascii_upcase) != "SPONSORED") else true end)) else . end) else . end) else . end) else . end'

[MITM]
hostname = %APPEND% api.taboola.com
