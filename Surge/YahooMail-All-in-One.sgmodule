#!name=Yahoo Mail 去广告（三合一）
#!desc=合并已验证组合：关闭 Yahoo Mail 广告位配置、过滤 Taboola、拦截 Google 广告域名。导入后关闭原三个模块。需 Rewrite、MITM 和信任个人 CA；Google 域名规则全设备生效。
# Version: 2.1.0 / 2026-11-10
# Requires Surge iOS 5.14+ / macOS 5.9+ for jq body rewrite.
# Exact rules merged from the three modules used successfully on Yahoo Mail 26.39.0.
# The combined file itself still requires device import verification.
# No external scripts. Does not modify mail/login/subscription responses.
# Config values may remain cached after disabling, until the next config fetch.

[Body Rewrite]
http-response-jq ^https://config\.mobile\.yahoo\.com/V3/getconfig(?:\?|$) 'if type == "object" and .doctype == "YMConfig" and (.feature["com.yahoo.MailSDK.domain"] | type) == "object" then .feature["com.yahoo.MailSDK.domain"] |= with_entries(if (.key as $k | ["adPlaceholderView","mailTineAds","topPencilAd","secondPencilAd","topPencilAdUsingTaboolaApi","secondPencilAdUsingTaboolaApi","mobileLeaderboard","infiniteMobileLeaderboard","infiniteMobileLeaderboardInMailTine","infiniteMobileLeaderboardOnIpad","nativeAdsEnabled","geminiAdsInAllFoldersEnabled","smAdManagerEnabled","sponsored_moments_ad_enabled","enableGraphicalAdsPrefetch","mobileLeaderboardPrefetch"] | index($k)) != null then .value |= walk(if type == "number" then 0 else . end) else . end) else . end'
http-response-jq ^https://api\.taboola\.com/2\.0/json/yahoo-ios-mail/recommendations\.get(?:\?|$) 'if type == "object" then (if (.placements | type) == "array" then .placements |= map(if type == "object" then (if (.list | type) == "array" then (.list |= map(select(if type == "object" then ((.origin // "" | tostring | ascii_upcase) != "SPONSORED") else true end))) | select(.list | length > 0) else . end) else . end) else . end) else . end'

[Rule]
DOMAIN,pubads.g.doubleclick-cn.net,REJECT
DOMAIN,googleads.g.doubleclick-cn.net,REJECT
DOMAIN,adx.g.doubleclick-cn.net,REJECT
DOMAIN,pagead2.googlesyndication.com,REJECT

[MITM]
hostname = %APPEND% config.mobile.yahoo.com, api.taboola.com
