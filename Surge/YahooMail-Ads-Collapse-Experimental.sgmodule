#!name=Yahoo Mail 去广告（Taboola，占位试验）
#!desc=占位处理试验版：过滤赞助内容后删除空的 Taboola 广告位记录。请关闭旧 Taboola 主模块再启用；是否收起灰色占位需在 Yahoo Mail 中验证，不能处理 Google 原生广告位的高度。
# Version: 1.1.0-experimental / 2026-11-09
# Requires Surge iOS 5.14+ / macOS 5.9+ for jq body rewrite.
# Based on the captured Yahoo Mail 26.39.0 Taboola response.
# Remove SPONSORED items, then omit placements whose list is empty.
# Retain non-sponsored items, unknown schemas, and top-level metadata.
# Native app layout collapse is NOT verified. No premium/account flags changed.
# Use INSTEAD OF YahooMail-Ads.sgmodule, not together with it.

[Body Rewrite]
http-response-jq ^https://api\.taboola\.com/2\.0/json/yahoo-ios-mail/recommendations\.get(?:\?|$) 'if type == "object" then (if (.placements | type) == "array" then .placements |= map(if type == "object" then (if (.list | type) == "array" then (.list |= map(select(if type == "object" then ((.origin // "" | tostring | ascii_upcase) != "SPONSORED") else true end))) | select(.list | length > 0) else . end) else . end) else . end) else . end'

[MITM]
hostname = %APPEND% api.taboola.com
